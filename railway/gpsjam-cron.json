{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "scripts/fetch-gpsjam.mjs",
      "package.json"
    ]
  },
  "deploy": {
    "runtime": "V2",
    "startCommand": "node scripts/fetch-gpsjam.mjs --output /tmp/gpsjam-latest.json",
    "restartPolicyType": "NEVER",
    "cronSchedule": "0 */6 * * *"
  }
}
