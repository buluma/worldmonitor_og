FROM node:22-alpine

# curl is used by the cron wrapper for cache priming; coreutils provides timeout.
# python3/make/g++ cover native module builds during npm ci on arm64/macOS hosts.
RUN apk add --no-cache curl coreutils python3 make g++

WORKDIR /app

COPY scripts/package.json scripts/package-lock.json ./scripts/
RUN npm ci --prefix scripts --omit=dev --no-audit --prefer-offline --fetch-retries=5 --fetch-retry-maxtimeout=300000

# Seed jobs only need the script tree plus shared/data payloads referenced at runtime.
COPY scripts/ ./scripts/
COPY shared/ ./shared/
COPY data/ ./data/

CMD ["tail", "-f", "/dev/null"]
